# ===== 필수 =====

# OpenAI API 키
OPENAI_API_KEY=

# postgresql+asyncpg://user:password@localhost:5432/dbname
DATABASE_URL=


# ===== 선택 (비워 두면 기본값) =====

# OpenAI
OPENAI_TIMEOUT=          # 기본값: 30.0
OPENAI_MAX_RETRIES=      # 기본값: 2
EMBEDDING_MODEL=         # 기본값: text-embedding-3-small (ETL과 같아야 함)
CHAT_MODEL=              # 기본값: gpt-6-luna

# Retrieval
RETRIEVER=               # 기본값: vector
TOP_K=                   # 기본값: 30 (청크 단위, 정책으로 묶으면 약 15~24개)
CARD_CANDIDATES=         # 기본값: 6 (답변 생성에 넘길 후보 정책 수)

# Conversation
HISTORY_TURNS=           # 기본값: 3 (질문 분석에 넘길 최근 대화 턴 수, 1턴 = 질문 + 답변)

# Analysis
ANALYSIS_MODEL=          # 기본값: CHAT_MODEL과 같음
ANALYSIS_ANSWER_MAX_CHARS=  # 기본값: 300 (질문 분석에 넣는 이전 답변의 앞부분 길이)
ANALYSIS_TIMEOUT=        # 기본값: 10.0 (초, 재시도 없이 실패하면 원래 질문으로 진행)

# Streaming
SSE_PING_INTERVAL=       # 기본값: 15.0 (초, 연결 유지용 :ping 간격)
CHAT_SKELETON_FIRST_DELAY=     # 기본값: 15.0 (초, 채팅 뼈대의 첫 token 전 대기)
CHAT_SKELETON_TOKENS=          # 기본값: 90 (채팅 뼈대가 보내는 token 수)
CHAT_SKELETON_TOKEN_INTERVAL=  # 기본값: 1.0 (초, token 사이 간격)


# ===== 테스트 (pytest) =====

# 저장소 테스트용 DB. 테스트 시작 때 새로 만들고 끝나면 삭제하므로 DB 이름은 _test로 끝나야 함
# 비워 두면 DB 테스트를 건너뜀
TEST_DATABASE_URL=       # 예: postgresql+asyncpg://user:password@localhost:5432/youthlink_test
