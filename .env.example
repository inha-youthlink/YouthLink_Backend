# 주석은 반드시 윗줄에 씀. Docker --env-file은 값 뒤의 # 주석까지 값으로 읽음

# ===== 필수 =====

# OpenAI API 키
OPENAI_API_KEY=

# postgresql+asyncpg://user:password@localhost:5432/dbname
DATABASE_URL=


# ===== 선택 (비워 두면 기본값) =====

# App
# 기본값: local (운영 서버는 prod: API 문서를 끄고 위험한 설정이면 시작하지 않음)
APP_ENV=
# 기본값: false (prod에서는 켤 수 없음)
DEBUG=

# Security
# /internal 호출 키 (평가 서버가 X-Internal-Key 헤더로 보냄). 비우면 검사하지 않음, prod에서는 32자 이상 필수
# 만들기: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_KEY=

# Vercel이 /api 요청에 붙이는 X-Origin-Secret 헤더 값. 비우면 검사하지 않음
# 켜면 EC2 주소로 직접 오는 공개 API 요청을 403으로 막음 (Vercel 쪽 설정이 먼저 필요)
ORIGIN_SECRET=
# 기본값: 262144 (요청 본문 최대 바이트, 넘으면 413. 0이면 끔)
MAX_BODY_BYTES=

# Rate limit (0이면 끔. 초과하면 429 RATE_LIMITED + Retry-After)
# 기본값: true (Vercel 뒤에서 X-Forwarded-For 첫 값을 접속 IP로 봄)
TRUST_PROXY_HEADERS=
# 기본값: 300 (공개 API 전체, IP당 분당. 같은 와이파이의 여러 명을 감안한 값)
RATE_LIMIT_PER_MINUTE=
# 기본값: 60 (채팅, IP당 분당. 같은 와이파이의 여러 명을 감안한 값)
CHAT_RATE_LIMIT_PER_MINUTE=
# 기본값: 10 (채팅, X-Client-Id당 분당)
CHAT_CLIENT_RATE_LIMIT_PER_MINUTE=
# 기본값: 1000 (서버 전체 하루 LLM 호출 수, 한국 자정 초기화, 재시작하면 0부터)
LLM_DAILY_LIMIT=

# OpenAI
# 기본값: 30.0
OPENAI_TIMEOUT=
# 기본값: 2
OPENAI_MAX_RETRIES=
# 기본값: text-embedding-3-small (ETL과 같아야 함)
EMBEDDING_MODEL=
# 기본값: gpt-6-luna
CHAT_MODEL=

# Retrieval
# 기본값: vector
RETRIEVER=
# 기본값: 30 (청크 단위, 정책으로 묶으면 약 15~24개)
TOP_K=
# 기본값: 6 (답변 생성에 넘길 후보 정책 수)
CARD_CANDIDATES=

# Conversation
# 기본값: 3 (질문 분석에 넘길 최근 대화 턴 수, 1턴 = 질문 + 답변)
HISTORY_TURNS=

# Analysis
# 기본값: CHAT_MODEL과 같음
ANALYSIS_MODEL=
# 기본값: 300 (질문 분석에 넣는 이전 답변의 앞부분 길이)
ANALYSIS_ANSWER_MAX_CHARS=
# 기본값: 10.0 (초, 재시도 없이 실패하면 원래 질문으로 진행)
ANALYSIS_TIMEOUT=

# Streaming
# 기본값: 15.0 (초, 연결 유지용 :ping 간격)
SSE_PING_INTERVAL=
# 기본값: 15.0 (초, 채팅 뼈대의 첫 token 전 대기)
CHAT_SKELETON_FIRST_DELAY=
# 기본값: 90 (채팅 뼈대가 보내는 token 수)
CHAT_SKELETON_TOKENS=
# 기본값: 1.0 (초, token 사이 간격)
CHAT_SKELETON_TOKEN_INTERVAL=


# ===== 테스트 (pytest) =====

# 저장소 테스트용 DB. 테스트 시작 때 새로 만들고 끝나면 삭제하므로 DB 이름은 _test로 끝나야 함
# 비워 두면 DB 테스트를 건너뜀
# 예: postgresql+asyncpg://user:password@localhost:5432/youthlink_test
TEST_DATABASE_URL=
